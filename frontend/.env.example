# Frontend Firebase config (safe placeholders for local emulator use)
# Copy this file to .env before running frontend in dev.

VITE_apiKey=demo-api-key
VITE_authDomain=demo-project.firebaseapp.com
VITE_databaseURL=
VITE_projectId=demo-project
VITE_storageBucket=demo-project.appspot.com
VITE_messagingSenderId=000000000000
VITE_appId=1:000000000000:web:demoappid
VITE_measurementId=

# Auth emulator URL used by src/features/firebase/firebaseApp.ts
VITE_AUTH_EMULATOR_HOST=http://localhost:9099

# Backend API base URL used for draft + publish requests
VITE_API_BASE_URL=http://localhost:3001/api

# Site id to publish against
VITE_SITE_ID=1
